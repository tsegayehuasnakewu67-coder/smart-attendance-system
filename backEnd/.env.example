# Set this to the MongoDB Atlas connection string for the existing database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/SmartAttendanceDB
MONGODB_DB_NAME=SmartAttendanceDB
RUN_EMPLOYEE_MIGRATION=false
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@smartattendance.com
ADMIN_PASSWORD=replace-with-a-secure-password
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
